@model RecipeBook.Models.Recipe

@{
    ViewData["Title"] = "Удалить рецепт";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="mb-3 text-danger">Удалить рецепт</h1>

                <p>Точно удалить рецепт <strong>@Model.Title</strong>?</p>

                <dl class="row">
                    <dt class="col-sm-3">Ингредиенты</dt>
                    <dd class="col-sm-9">@Model.Ingredients</dd>

                    <dt class="col-sm-3">Инструкции</dt>
                    <dd class="col-sm-9">@Model.Instructions</dd>
                </dl>

                <form asp-action="Delete" method="post" class="d-flex gap-2">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Да, удалить</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                </form>
            </div>
        </div>
    </div>
</div>