@model RecipeBook.Models.Recipe

@{
    ViewData["Title"] = Model.Title;
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
            <div>
                <h1 class="mb-2">@Model.Title</h1>

                @if (Model.IsSystemRecipe)
                {
                    <span class="badge bg-info text-dark">Предустановленный рецепт</span>
                }
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="Alternative" asp-route-id="@Model.Id" class="btn btn-outline-success">
                    Альтернатива
                </a>

                @if (!Model.IsSystemRecipe)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                        Редактировать
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        Удалить
                    </a>
                }

                <a asp-action="Index" class="btn btn-outline-primary">
                    Назад
                </a>
            </div>
        </div>

        <hr />

        <div class="mb-4">
            <h5 class="text-primary">Ингредиенты</h5>
            <div class="bg-light rounded-3 p-3">
                @Model.Ingredients
            </div>
        </div>

        <div>
            <h5 class="text-primary">Инструкции</h5>
            <div class="bg-light rounded-3 p-3">
                @Model.Instructions
            </div>
        </div>
    </div>
</div>