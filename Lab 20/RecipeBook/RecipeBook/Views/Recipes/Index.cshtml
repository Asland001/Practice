@model IEnumerable<RecipeBook.Models.Recipe>

@{
    ViewData["Title"] = "Список рецептов";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h1 class="mb-1">Список рецептов</h1>
        <p class="text-muted mb-0">CRUD на базе EF Core</p>
    </div>

    <a asp-action="Create" class="btn btn-success btn-lg">+ Добавить рецепт</a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success shadow-sm">
        @message
    </div>
}

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var recipe in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@recipe.Title</h5>

                        <p class="card-text text-muted">
                            @recipe.Ingredients
                        </p>

                        <div class="mt-auto d-flex gap-2 flex-wrap">
                            <a asp-action="Details" asp-route-id="@recipe.Id" class="btn btn-primary btn-sm">Подробнее</a>
                            <a asp-action="Edit" asp-route-id="@recipe.Id" class="btn btn-outline-secondary btn-sm">Редактировать</a>
                            <a asp-action="Delete" asp-route-id="@recipe.Id" class="btn btn-outline-danger btn-sm">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info shadow-sm">
        Пока нет ни одного рецепта.
    </div>
}