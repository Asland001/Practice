@model List<RecipeBook.Models.Recipe>

@{
    ViewData["Title"] = "Список рецептов";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Список рецептов</h1>
        <p class="text-muted mb-0">Выберите рецепт или добавьте новый</p>
    </div>
    <a asp-action="Create" class="btn btn-success btn-lg">
        + Добавить рецепт
    </a>
</div>

@if (Model != null && Model.Count > 0)
{
    <div class="row g-4">
        @foreach (var recipe in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@recipe.Title</h5>

                        <p class="card-text text-muted flex-grow-1">
                            <strong>Ингредиенты:</strong><br />
                            @recipe.Ingredients
                        </p>

                        <a href="/Recipes/View/@recipe.Id" class="btn btn-primary mt-auto">
                            Открыть рецепт
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info shadow-sm">
        Рецептов пока нет. Нажмите «Добавить рецепт», чтобы создать первый.
    </div>
}