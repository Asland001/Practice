<Window x:Class="CinemaApp.Views.BookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CinemaApp.ViewModels"
        Title="Выбор места"
        Height="540"
        Width="780"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Opacity="0"
        Background="#F5F7FB">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SeatButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SeatBorder"
                                Background="#CFF7D3"
                                CornerRadius="10"
                                Padding="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="SeatBorder"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#A7D8FF"
                                                            Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="SeatBorder"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#CFF7D3"
                                                            Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SeatBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <DataTrigger Binding="{Binding IsBooked}" Value="True">
                                <Setter TargetName="SeatBorder" Property="Background" Value="#B5B5B5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupCardStyle" TargetType="Border">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="18"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1"
                                                 Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="18" To="0"
                                                 Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
        </Grid.RenderTransform>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1"
                                         Duration="0:0:0.35"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                         From="0.96" To="1"
                                         Duration="0:0:0.35"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                         From="0.96" To="1"
                                         Duration="0:0:0.35"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="Схема зала"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <Border Background="White"
                    BorderBrush="#D9E0EA"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12">
                <ItemsControl ItemsSource="{Binding Seats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Number}"
                                    Style="{StaticResource SeatButtonStyle}"
                                    Command="{Binding DataContext.BookSeatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.ToolTip>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding Number, StringFormat=Место №{0}}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding StatusText}"/>
                                    </StackPanel>
                                </Button.ToolTip>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <Border Background="White"
                    BorderBrush="#D9E0EA"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14"
                    Margin="0,32,0,0">
                <StackPanel>
                    <TextBlock Text="Информация о сеансе"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding CurrentSessionTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CurrentSessionTime, StringFormat=Время: {0}}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding CurrentSessionSeats, StringFormat=Свободных мест: {0}}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#EEF4FF"
                    BorderBrush="#D9E0EA"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="14"
                    Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Подсказка"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Нажмите на место, чтобы увидеть всплывающую карточку с деталями сеанса."
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0"
                Style="{StaticResource PopupCardStyle}"
                Visibility="{Binding IsSessionPopupVisible, Converter={StaticResource BoolToVis}}">
            <Border.Background>
                <SolidColorBrush Color="White"/>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="#D9E0EA"/>
            </Border.BorderBrush>
            <Border.BorderThickness>1</Border.BorderThickness>
            <Border.CornerRadius>14</Border.CornerRadius>
            <Border.Padding>14</Border.Padding>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.18"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Информация о выбранном месте"
                           FontWeight="Bold"
                           FontSize="15"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding SeatPopupMessage}"
                           TextWrapping="Wrap"
                           Width="280"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>