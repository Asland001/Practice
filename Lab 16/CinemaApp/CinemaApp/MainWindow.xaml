<Window x:Class="CinemaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CinemaApp.ViewModels"
        Title="CinemaApp" Height="650" Width="980"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding BookTicketCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding EditTicketCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding CancelTicketCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Забронировать билет" Command="{Binding BookTicketCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="Изменить бронь" Command="{Binding EditTicketCommand}" InputGestureText="Ctrl+E"/>
                <MenuItem Header="Отменить бронь" Command="{Binding CancelTicketCommand}" InputGestureText="Ctrl+D"/>
            </MenuItem>
            <MenuItem Header="Фильмы">
                <MenuItem Header="Обновить список" Command="{Binding ApplyFilterCommand}"/>
            </MenuItem>
            <MenuItem Header="Зал">
                <MenuItem Header="Открыть зал" Command="{Binding BookTicketCommand}"/>
            </MenuItem>
            <MenuItem Header="Настройки">
                <MenuItem Header="Сбросить фильтр" Command="{Binding ResetFilterCommand}"/>
            </MenuItem>
        </Menu>

        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Забронировать билет" Width="170" Margin="0,0,8,0" Command="{Binding BookTicketCommand}"/>
                    <Button Content="Изменить бронь" Width="140" Margin="0,0,8,0" Command="{Binding EditTicketCommand}"/>
                    <Button Content="Отменить бронь" Width="140" Command="{Binding CancelTicketCommand}"/>
                </StackPanel>

                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Фильтр по времени" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBox Width="120" Text="{Binding TimeFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <Button Content="Применить" Width="100" Command="{Binding ApplyFilterCommand}" Margin="0,0,8,0"/>
                            <Button Content="Сброс" Width="80" Command="{Binding ResetFilterCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Сеансы" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>

                <ListBox ItemsSource="{Binding SessionsView}"
                         SelectedItem="{Binding SelectedSession}"
                         Height="290">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding MovieName}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Time}" />
                                    <TextBlock>
                                        <Run Text="Свободных мест: "/>
                                        <Run Text="{Binding AvailableSeats}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Выбранный фильм" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedMovieName}" Margin="0,4,0,0"/>

                        <TextBlock Text="Количество билетов" FontWeight="Bold" Margin="0,12,0,0"/>
                        <TextBox Width="80"
                                 Text="{Binding TicketCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Button Content="Купить билет"
                        Height="50"
                        Command="{Binding BuyTicketCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#2D5BFF" CornerRadius="12" Padding="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="White"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>